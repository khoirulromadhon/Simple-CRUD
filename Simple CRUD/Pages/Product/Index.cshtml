@page
@model Simple_CRUD.Pages.Product.IndexModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Products</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; margin: 20px; }
        .toolbar { display:flex; gap:10px; align-items:center; margin-bottom:12px; }
        .left { margin-right:auto; }
        button { padding:8px 12px; cursor:pointer; }
        input[type=text], input[type=number] { padding:6px; }
        table { width:100%; border-collapse:collapse; margin-top:12px; }
        th, td { border:1px solid #ddd; padding:8px; text-align:left; }
        th { background:#f4f4f4; }
        tr:nth-child(even) { background:#fbfbfb; }
        .actions button { margin-left:6px; }
        .modal { position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(0,0,0,0.4); display:none; align-items:center; justify-content:center; }
        .modal.show { display:flex; }
        .modal-content { background:#fff; padding:16px; width:420px; border-radius:6px; box-shadow:0 2px 8px rgba(0,0,0,0.2); }
        .form-row { margin-bottom:8px; }
        .form-row label { display:block; font-size:13px; margin-bottom:4px; }
        .pagination { margin-top:10px; display:flex; gap:8px; justify-content:flex-end; }
        .small { font-size:13px; color:#666; }
    </style>
</head>
<body>
    <h1>Products</h1>

    <div class="toolbar">
        <div class="left">
            <button id="btn-add">Tambah Data</button>
        </div>

        <div style="display:flex; gap:8px; align-items:center;">
            <input id="filter-search" type="text" placeholder="Search name" />
            <input id="filter-min" type="number" step="0.01" placeholder="Min price" style="width:110px" />
            <input id="filter-max" type="number" step="0.01" placeholder="Max price" style="width:110px" />
            <button id="btn-search">Search</button>
        </div>
    </div>

    
    <div id="table-container">
        <table id="products-table">
            <thead>
                <tr>
                    <th style="width:120px">ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th style="width:120px">Price</th>
                    <th style="width:160px">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="pagination">
        <button id="btn-prev" disabled>Prev</button>
        <button id="btn-next" disabled>Next</button>
    </div>

    <!-- Modal -->
    <div id="modal" class="modal" role="dialog">
        <div class="modal-content">
            <h3 id="modal-title">Add Product</h3>
            <div class="form-row">
                <label for="p-name">Name</label>
                <input id="p-name" type="text" style="width:100%" />
            </div>
            <div class="form-row">
                <label for="p-desc">Description</label>
                <input id="p-desc" type="text" style="width:100%" />
            </div>
            <div class="form-row">
                <label for="p-price">Price</label>
                <input id="p-price" type="number" step="0.01" style="width:100%" />
            </div>
            <div style="text-align:right; margin-top:10px;">
                <button id="btn-cancel">Cancel</button>
                <button id="btn-save">Save</button>
            </div>
        </div>
    </div>

    <script>

        const apiBase = '/api/product';
        let cursorId = 0; 
        let lastCursor = 0;

        function getToken(){
            return '';
        }

        async function loadProducts(cId = 0){
            const search = encodeURIComponent(document.getElementById('filter-search').value || '');
            const min = document.getElementById('filter-min').value;
            const max = document.getElementById('filter-max').value;
            const qs = `?search=${search}&minPrice=${min}&maxPrice=${max}&cursorId=${cId}`;

            const res = await fetch(apiBase + '/get-all' + qs, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if(!res.ok){
                const txt = await res.text();
                alert('Failed to load products: ' + res.status + '\n' + txt);
                return;
            }

            const data = await res.json();
            renderTable(data);
            if(data && data.length > 0){
                lastCursor = data[data.length - 1].id || 0;
                document.getElementById('btn-next').disabled = false;
            } else {
                lastCursor = 0;
                document.getElementById('btn-next').disabled = true;
            document.getElementById('btn-prev').disabled = (cId <= 0);
            cursorId = cId;
        }

        function renderTable(items){
            const tbody = document.querySelector('#products-table tbody');
            tbody.innerHTML = '';
            if(!items || items.length === 0){
                const tr = document.createElement('tr');
                tr.innerHTML = '<td colspan="5">No data</td>';
                tbody.appendChild(tr);
                return;
            }

            items.forEach(p => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${p.id}</td>
                    <td class="cell-name">${escapeHtml(p.name)}</td>
                    <td class="cell-desc">${escapeHtml(p.description || '')}</td>
                    <td class="cell-price">${Number(p.price).toFixed(2)}</td>
                    <td class="actions">
                        <button data-id="${p.id}" class="btn-edit">Edit</button>
                        <button data-id="${p.id}" class="btn-delete">Delete</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.querySelectorAll('.btn-edit').forEach(b => b.addEventListener('click', (e) => {
                const id = Number(e.currentTarget.getAttribute('data-id'));
                const row = e.currentTarget.closest('tr');
                openEditModalFromRow(row, id);
            }));

            document.querySelectorAll('.btn-delete').forEach(b => b.addEventListener('click', async (e) => {
                const id = Number(e.currentTarget.getAttribute('data-id'));
                if(!confirm('Delete product id ' + id + '?')) return;
                await deleteProduct(id);
                loadProducts(cursorId);
            }));
        }

        function escapeHtml(s){
            if(!s) return '';
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        function openEditModalFromRow(row, id){
            const name = row.querySelector('.cell-name').innerText;
            const desc = row.querySelector('.cell-desc').innerText;
            const price = row.querySelector('.cell-price').innerText;
            openModal({ id, name, description: desc, price: Number(price) });
        }

        function openModal(product){
            document.getElementById('modal-title').innerText = product && product.id ? 'Edit Product' : 'Add Product';
            document.getElementById('p-name').value = product ? product.name : '';
            document.getElementById('p-desc').value = product ? product.description : '';
            document.getElementById('p-price').value = product ? (product.price || 0) : 0;
            document.getElementById('modal').classList.add('show');
            document.getElementById('modal').dataset.editId = product && product.id ? product.id : 0;
        }

        function closeModal(){
            document.getElementById('modal').classList.remove('show');
            document.getElementById('modal').dataset.editId = 0;
        }

        async function saveProduct(){
            const id = Number(document.getElementById('modal').dataset.editId || 0);
            const name = document.getElementById('p-name').value.trim();
            const desc = document.getElementById('p-desc').value.trim();
            const price = parseFloat(document.getElementById('p-price').value) || 0;
            if(!name){ alert('Name required'); return; }

            const body = { id: id, name: name, description: desc, price: price };
            const res = await fetch(apiBase + '/create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(body)
            });
            if(!res.ok){ const txt = await res.text(); alert('Save failed: ' + res.status + '\n' + txt); return; }
            closeModal();
            loadProducts(0);
        }

        async function deleteProduct(id){
            const res = await fetch(apiBase + '/delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(id)
            });
            if(!res.ok){ const txt = await res.text(); alert('Delete failed: ' + res.status + '\n' + txt); return false; }
            return true;
        }

        document.getElementById('btn-add').addEventListener('click', () => openModal(null));
        document.getElementById('btn-cancel').addEventListener('click', closeModal);
        document.getElementById('btn-save').addEventListener('click', saveProduct);
        document.getElementById('btn-search').addEventListener('click', () => loadProducts(0));

        document.getElementById('btn-next').addEventListener('click', () => {
            if(lastCursor) loadProducts(lastCursor);
        });
        document.getElementById('btn-prev').addEventListener('click', () => {
            loadProducts(0);
        });

        loadProducts(0);
    </script>
</body>
</html>
